{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    { "source": "/pwa", "destination": "/pwa/index.html" },
    { "source": "/pwa/", "destination": "/pwa/index.html" }
  ]
}
