# FastAPI Core Engine Settings
RAMANI_ENV=development
RAMANI_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RAMANI_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
RAMANI_DATABASE_URL=sqlite:///./ramani.db
RAMANI_REDIS_URL=redis://localhost:6379/0
RAMANI_REDIS_ENABLED=false
RAMANI_DEFAULT_SETTLEMENT=kibera
RAMANI_LOG_LEVEL=INFO

# Security & Secret Authentication
# Set RAMANI_PLANNER_API_KEY to enforce authentication on /api/v1/sos and /admin endpoints
RAMANI_PLANNER_API_KEY=
# Set RAMANI_USSD_WEBHOOK_SECRET to enforce HMAC signature verification on /api/v1/ussd callbacks
RAMANI_USSD_WEBHOOK_SECRET=

# Operational Thresholds
RAMANI_HAZARD_PENALTY_TTL_HOURS=24
RAMANI_GRAPH_STALE_HOURS=168

# Africa's Talking Gateway (set username to 'sandbox' for testing, or your AT live username)
RAMANI_SMS_ENABLED=false
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SMS_SENDER=RAMANI

# Phone hashing (HMAC) — callback number is stored for dispatch, hash is the public identity
RAMANI_PHONE_HASH_SECRET=change-me
RAMANI_OPS_PUBLIC_URL=http://localhost:3000

# WhatsApp Cloud API (optional). Without a token, alerts print to the worker console.
RAMANI_WHATSAPP_RESPONDERS=
RAMANI_WHATSAPP_VERIFY_TOKEN=
RAMANI_WHATSAPP_TOKEN=
RAMANI_WHATSAPP_PHONE_ID=

# Planner & Community Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PLANNER_API_KEY=
NEXT_PUBLIC_COMMUNITY_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=
